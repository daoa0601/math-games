{
  "name": "@math-games/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "check": "prettier --check . && turbo typecheck && turbo lint && turbo test && turbo build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preflight": "pnpm check && pnpm infra:check",
    "deploy": "pnpm --filter infra run deploy",
    "infra:check": "pnpm --filter @math-games/infra run check",
    "infra:bootstrap": "pnpm --filter @math-games/infra run bootstrap",
    "infra:plan": "pnpm --filter @math-games/infra run plan",
    "smoke:remote": "pnpm --filter @math-games/infra exec tsx scripts/smokeRemoteWorker.ts"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "prettier": "3.8.3",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ],
    "overrides": {
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.6"
    }
  }
}
