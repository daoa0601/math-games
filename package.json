{
  "name": "@math-games/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "check": "turbo build && turbo typecheck && turbo test && turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm --filter infra run deploy"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "turbo": "2.5.4",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ],
    "overrides": {
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.66"
    }
  }
}
