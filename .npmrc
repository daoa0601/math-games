# Pin all future `pnpm add` calls to exact versions (no ^ or ~ prefixes).
save-exact=true

# Deduplicate packages that differ only in peer dependency context.
# Prevents type duplication issues with drizzle-orm, effect, etc.
dedupe-peer-dependents=true

# Supply-chain: only resolve packages published before this date.
# Prevents a silently-compromised newer publish from being pulled in.
# Bump this date intentionally when upgrading dependencies.
before=2026-05-14T00:00:00.000Z
