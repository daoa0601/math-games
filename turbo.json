{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["TURBO_TELEMETRY_DISABLED"],
  "globalPassThroughEnv": ["TMPDIR", "TEMP", "TMP"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    }
  }
}
