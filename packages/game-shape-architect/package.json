{
  "name": "@math-games/game-shape-architect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./three-scene": {
      "types": "./src/rendering/three-scene.ts",
      "default": "./src/rendering/three-scene.ts"
    },
    "./forge": {
      "types": "./dist/solution-forge.d.ts",
      "default": "./dist/solution-forge.js"
    },
    "./src/*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint"
  },
  "dependencies": {
    "@math-games/core": "workspace:*",
    "effect": "4.0.0-beta.66",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/three": "0.184.1",
    "react": "19.2.6",
    "tsup": "8.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
