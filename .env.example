# API Server URL (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Firebase Configuration (optional - app works without Firebase using localStorage)
# Get these values from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=math-games-dbd61.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=math-games-dbd61
VITE_FIREBASE_STORAGE_BUCKET=math-games-dbd61.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=923890248868
VITE_FIREBASE_APP_ID=

# Firebase feature flag (set to 'false' to disable Firebase even if configured)
VITE_USE_FIREBASE=true

# Firebase Emulators (development only)
VITE_USE_FIREBASE_EMULATORS=false
