# API Server URL (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Firebase Configuration (optional - app works without Firebase using localStorage)
# Get these values from your Firebase Console: https://console.firebase.google.com
# Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase feature flag (set to 'false' to disable Firebase even if configured)
VITE_USE_FIREBASE=true

# Firebase Emulators (development only)
VITE_USE_FIREBASE_EMULATORS=false
