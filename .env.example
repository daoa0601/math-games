# Disable Turborepo telemetry (sends anonymous data to Vercel by default).
TURBO_TELEMETRY_DISABLED=1

# Scoped token auth and workers.dev smoke resolution.
# Alchemy runs in env-auth mode when both values are present.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local Alchemy profile auth. Leave as default unless you created another profile.
ALCHEMY_PROFILE=default

# Required after local-profile deploys or for custom domains.
# CI token deploys may leave this blank when workers.dev is enabled.
# Remote smoke must verify /profile D1 marker + mg_player and /daily D1 marker.
START_REMOTE_URL=
